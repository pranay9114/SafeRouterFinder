# TomTom Traffic API Key
TOMTOM_API_KEY=your_tomtom_api_key_here

# GraphHopper Routing Engine:
# Option A (Recommended for Render Free Tier): Use hosted GraphHopper Cloud API
GRAPHOPPER_URL=https://graphhopper.com/api/1/route
GRAPHHOPPER_API_KEY=your_graphhopper_cloud_api_key

# Option B: Local or Self-Hosted GraphHopper (Render Starter 2GB+ or Localhost)
# GRAPHOPPER_URL=http://localhost:8989/route

# Deployed Frontend URL (for CORS allowed origins)
FRONTEND_URL=https://your-frontend-app.onrender.com
